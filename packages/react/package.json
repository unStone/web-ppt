{
  "name": "@web-ppt/react",
  "version": "0.5.0-beta.4",
  "description": "Thin React component and hook for the framework-agnostic Web-PPT viewer/editor.",
  "keywords": ["pptx", "powerpoint", "react", "editor", "viewer", "browser", "typescript"],
  "license": "MIT",
  "author": "unStone",
  "homepage": "https://github.com/unStone/web-ppt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unStone/web-ppt.git",
    "directory": "packages/react"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/react.js",
  "module": "./dist/react.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/react.js" },
    "./templates": { "types": "./dist/templates/index.d.ts", "import": "./dist/templates.js" },
    "./chart": { "types": "./dist/chart/index.d.ts", "import": "./dist/chart.js" },
    "./chart-shared": { "types": "./dist/chart-shared/index.d.ts", "import": "./dist/chart-shared.js" },
    "./media": { "types": "./dist/media/index.d.ts", "import": "./dist/media.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "scripts": {
    "build": "vite build && vite build --config vite.templates.config.ts && vite build --config vite.chart.config.ts && vite build --config vite.media.config.ts && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "prepack": "node ../../tooling/sync-package-docs.mjs"
  },
  "peerDependencies": {
    "@web-ppt/editor": "^0.5.0-beta.4",
    "react": ">=18.2.0 <20"
  },
  "peerDependenciesMeta": { "react": { "optional": true } },
  "publishConfig": { "access": "public" }
}
