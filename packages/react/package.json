{
  "name": "@web-ppt/react",
  "version": "0.4.5",
  "description": "Thin React component and hook for the framework-agnostic Web-PPT viewer/editor.",
  "keywords": ["pptx", "powerpoint", "react", "editor", "viewer", "browser", "typescript"],
  "license": "MIT",
  "author": "unStone",
  "homepage": "https://github.com/unStone/web-ppt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unStone/web-ppt.git",
    "directory": "packages/react"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/react.js",
  "module": "./dist/react.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/react.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "prepack": "node ../../tooling/sync-package-docs.mjs"
  },
  "peerDependencies": {
    "@web-ppt/editor": "^0.4.5",
    "react": ">=18.2.0 <20"
  },
  "peerDependenciesMeta": { "react": { "optional": true } },
  "publishConfig": { "access": "public" }
}
