{
  "name": "@web-ppt/fonts",
  "version": "0.5.0-beta.2",
  "description": "Font substitution and on-demand web-font loading for PowerPoint decks: metric-compatible free substitutes plus a unicode-range slice loader. Zero font bytes in the package.",
  "keywords": [
    "pptx",
    "ppt",
    "powerpoint",
    "font",
    "webfont",
    "font-substitution",
    "metric-compatible",
    "unicode-range",
    "subset",
    "cjk",
    "browser",
    "typescript"
  ],
  "license": "MIT",
  "author": "unStone",
  "homepage": "https://github.com/unStone/web-ppt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unStone/web-ppt.git",
    "directory": "packages/fonts"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/fonts.js",
  "module": "./dist/fonts.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/fonts.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "prepack": "node ../../tooling/sync-package-docs.mjs"
  },
  "peerDependencies": {
    "@web-ppt/core": "^0.5.0-beta.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
