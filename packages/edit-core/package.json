{
  "name": "@web-ppt/edit-core",
  "version": "0.5.0-beta.4",
  "description": "Headless, framework-agnostic editing document model and render projection for Web-PPT.",
  "keywords": [
    "pptx",
    "ppt",
    "powerpoint",
    "editor",
    "headless",
    "browser",
    "ooxml",
    "typescript"
  ],
  "license": "MIT",
  "author": "unStone",
  "homepage": "https://github.com/unStone/web-ppt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unStone/web-ppt.git",
    "directory": "packages/edit-core"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/edit-core.js",
  "module": "./dist/edit-core.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/edit-core.js"
    },
    "./xml": {
      "types": "./dist/xml/index.d.ts",
      "import": "./dist/xml.js"
    },
    "./opc": {
      "types": "./dist/opc/index.d.ts",
      "import": "./dist/opc.js"
    },
    "./save": {
      "types": "./dist/save/index.d.ts",
      "import": "./dist/save.js"
    },
    "./generate": {
      "types": "./dist/generate/index.d.ts",
      "import": "./dist/generate.js"
    },
    "./templates": {
      "types": "./dist/templates/index.d.ts",
      "import": "./dist/templates.js"
    },
    "./chart": {
      "types": "./dist/chart/index.d.ts",
      "import": "./dist/chart.js"
    },
    "./media": {
      "types": "./dist/media/index.d.ts",
      "import": "./dist/media.js"
    },
    "./package.json": "./package.json",
    "./appearance": {
      "types": "./dist/appearance/index.d.ts",
      "import": "./dist/appearance.js"
    },
    "./resize": {
      "types": "./dist/resize/index.d.ts",
      "import": "./dist/resize.js"
    },
    "./comments": {
      "types": "./dist/comments/index.d.ts",
      "import": "./dist/comments.js"
    },
    "./chart-design": {
      "types": "./dist/chart-design/index.d.ts",
      "import": "./dist/chart-design.js"
    },
    "./chart-ex": {
      "types": "./dist/chart-ex/index.d.ts",
      "import": "./dist/chart-ex.js"
    },
    "./smartart": {
      "types": "./dist/smartart/index.d.ts",
      "import": "./dist/smartart.js"
    },
    "./cfb": {
      "types": "./dist/cfb/index.d.ts",
      "import": "./dist/cfb.js"
    },
    "./ole": {
      "types": "./dist/ole/index.d.ts",
      "import": "./dist/ole.js"
    },
    "./ink": {
      "types": "./dist/ink/index.d.ts",
      "import": "./dist/ink.js"
    },
    "./ppt": {
      "types": "./dist/ppt/index.d.ts",
      "import": "./dist/ppt.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && vite build --config vite.templates.config.ts && vite build --config vite.chart.config.ts && vite build --config vite.media.config.ts && vite build --config vite.appearance.config.ts && vite build --config vite.resize.config.ts && node ../../tooling/check-preset-handles-boundary.mjs edit-core && tsc -p tsconfig.build.json && vite build --config vite.comments.config.ts && vite build --config vite.chart-design.config.ts && vite build --config vite.chart-ex.config.ts && vite build --config vite.smartart.config.ts && vite build --config vite.cfb.config.ts && vite build --config vite.ole.config.ts && vite build --config vite.ink.config.ts && vite build --config vite.ppt.config.ts",
    "prepublishOnly": "npm run build",
    "prepack": "node ../../tooling/sync-package-docs.mjs"
  },
  "peerDependencies": {
    "@web-ppt/core": "^0.5.0-beta.4"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
