{
  "name": "@web-ppt/edit-core",
  "version": "0.5.0-beta.1",
  "description": "Headless, framework-agnostic editing document model and render projection for Web-PPT.",
  "keywords": [
    "pptx",
    "ppt",
    "powerpoint",
    "editor",
    "headless",
    "browser",
    "ooxml",
    "typescript"
  ],
  "license": "MIT",
  "author": "unStone",
  "homepage": "https://github.com/unStone/web-ppt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unStone/web-ppt.git",
    "directory": "packages/edit-core"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/edit-core.js",
  "module": "./dist/edit-core.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/edit-core.js"
    },
    "./xml": {
      "types": "./dist/xml/index.d.ts",
      "import": "./dist/xml.js"
    },
    "./opc": {
      "types": "./dist/opc/index.d.ts",
      "import": "./dist/opc.js"
    },
    "./save": {
      "types": "./dist/save/index.d.ts",
      "import": "./dist/save.js"
    },
    "./generate": {
      "types": "./dist/generate/index.d.ts",
      "import": "./dist/generate.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "prepack": "node ../../tooling/sync-package-docs.mjs"
  },
  "peerDependencies": {
    "@web-ppt/core": "^0.5.0-beta.1"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
