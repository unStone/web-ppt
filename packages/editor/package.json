{
  "name": "@web-ppt/editor",
  "version": "0.5.0-beta.5",
  "description": "Framework-agnostic browser editing session and DOM view for Web-PPT.",
  "keywords": [
    "pptx",
    "powerpoint",
    "editor",
    "browser",
    "svg",
    "react",
    "vue",
    "typescript"
  ],
  "license": "MIT",
  "author": "unStone",
  "homepage": "https://github.com/unStone/web-ppt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unStone/web-ppt.git",
    "directory": "packages/editor"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/editor.js",
  "module": "./dist/editor.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/editor.js"
    },
    "./vertex": {
      "types": "./dist/vertex/index.d.ts",
      "import": "./dist/vertex.js"
    },
    "./adjustments": {
      "types": "./dist/adjustments/index.d.ts",
      "import": "./dist/adjustments.js"
    },
    "./design": {
      "types": "./dist/design/index.d.ts",
      "import": "./dist/design.js"
    },
    "./templates": {
      "types": "./dist/templates/index.d.ts",
      "import": "./dist/templates.js"
    },
    "./chart": {
      "types": "./dist/chart/index.d.ts",
      "import": "./dist/chart.js"
    },
    "./chart-shared": {
      "types": "./dist/chart-shared/index.d.ts",
      "import": "./dist/chart-shared.js"
    },
    "./media": {
      "types": "./dist/media/index.d.ts",
      "import": "./dist/media.js"
    },
    "./package.json": "./package.json",
    "./accessibility": {
      "types": "./dist/canvas-accessibility.d.ts",
      "import": "./dist/accessibility.js"
    },
    "./edit-context": {
      "types": "./dist/edit-context/index.d.ts",
      "import": "./dist/edit-context.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && node ../../tooling/check-editor-main-size.mjs && vite build --config vite.vertex.config.ts && vite build --config vite.adjustments.config.ts && vite build --config vite.design.config.ts && vite build --config vite.templates.config.ts && vite build --config vite.chart.config.ts && vite build --config vite.media.config.ts && vite build --config vite.browser-features.config.ts && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "prepack": "node ../../tooling/sync-package-docs.mjs"
  },
  "peerDependencies": {
    "@web-ppt/core": "^0.5.0-beta.5",
    "@web-ppt/edit-core": "^0.5.0-beta.5",
    "@web-ppt/viewer-core": "^0.5.0-beta.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
