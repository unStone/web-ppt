{
  "name": "@web-ppt/viewer-core",
  "version": "0.4.2",
  "description": "Web-PPT 查看器的 headless 状态机与播放层：导航 / 缩放 / 搜索 / 动画批次，可被任意 UI 框架驱动",
  "keywords": [
    "pptx",
    "ppt",
    "powerpoint",
    "viewer",
    "headless",
    "state-machine",
    "presentation",
    "slideshow",
    "svg",
    "browser",
    "react",
    "vue",
    "svelte",
    "typescript"
  ],
  "license": "MIT",
  "author": "unStone",
  "homepage": "https://github.com/unStone/web-ppt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unStone/web-ppt.git",
    "directory": "packages/viewer-core"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/viewer-core.js",
  "module": "./dist/viewer-core.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/viewer-core.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "prepack": "node ../../tooling/sync-package-docs.mjs"
  },
  "peerDependencies": {
    "@web-ppt/core": "^0.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
