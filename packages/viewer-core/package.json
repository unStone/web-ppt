    "directory": "packages/viewer-core"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/viewer-core.js",
  "module": "./dist/viewer-core.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/viewer-core.js" },
