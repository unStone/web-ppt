{
  "name": "@web-ppt/collab",
  "version": "0.5.0-beta.2",
  "description": "Optional field-level LWW collaboration adapter for @web-ppt/edit-core with pluggable providers.",
  "keywords": ["pptx", "powerpoint", "collaboration", "offline", "lww", "browser", "typescript"],
  "license": "MIT",
  "author": "unStone",
  "homepage": "https://github.com/unStone/web-ppt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unStone/web-ppt.git",
    "directory": "packages/collab"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/collab.js",
  "module": "./dist/collab.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/collab.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "prepack": "node ../../tooling/sync-package-docs.mjs"
  },
  "peerDependencies": {
    "@web-ppt/edit-core": "^0.5.0-beta.2"
  },
  "publishConfig": { "access": "public" }
}
