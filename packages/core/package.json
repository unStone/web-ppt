{
  "name": "@web-ppt/core",
  "version": "0.5.0-beta.3",
  "description": "Render .pptx and .ppt entirely in the browser — no server, no Office, no upload. OOXML and binary OfficeArt into one JSON schema, out as SVG.",
  "keywords": [
    "pptx",
    "ppt",
    "powerpoint",
    "presentation",
    "slides",
    "renderer",
    "viewer",
    "svg",
    "browser",
    "ooxml",
    "drawingml",
    "emf",
    "wmf",
    "pict",
    "quickdraw",
    "omml",
    "math",
    "smartart",
    "chart",
    "animation",
    "encryption",
    "office",
    "open-xml",
    "client-side",
    "no-server",
    "typescript"
  ],
  "license": "MIT",
  "author": "unStone",
  "homepage": "https://github.com/unStone/web-ppt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unStone/web-ppt.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/unStone/web-ppt/issues"
  },
  "type": "module",
  "sideEffects": [
    "./dist/core.js"
  ],
  "main": "./dist/core.js",
  "module": "./dist/core.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/core.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./geometry": {
      "types": "./dist/geometry/index.d.ts",
      "import": "./dist/geometry.js"
    },
    "./geometry/handles": {
      "types": "./dist/geometry/handles/index.d.ts",
      "import": "./dist/geometry-handles.js"
    },
    "./image-zip": {
      "types": "./dist/image-zip.d.ts",
      "import": "./dist/image-zip.js"
    },
    "./chart-edit": {
      "types": "./dist/chart-edit.d.ts",
      "import": "./dist/chart-edit.js"
    },
    "./package.json": "./package.json",
    "./chart-ex": {
      "types": "./dist/chart-ex.d.ts",
      "import": "./dist/chart-ex.js"
    },
    "./modern-charts": {
      "types": "./dist/modern-charts.d.ts",
      "import": "./dist/modern-charts.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && vite build --config vite.handles.config.ts && vite build --config vite.image-zip.config.ts && vite build --config vite.chart-edit.config.ts && vite build --config vite.chart-ex.config.ts && vite build --config vite.modern-charts.config.ts && node ../../tooling/check-preset-handles-boundary.mjs core && node ../../tooling/check-image-zip-boundary.mjs && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "prepack": "node ../../tooling/sync-package-docs.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
