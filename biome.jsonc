{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "packages/*/src/**/*.ts",
      "packages/*/src/**/*.tsx",
      "packages/*/*.ts",
      "tooling/**/*.mjs",
      "tooling/**/*.ts",
      "tooling/**/*.tsx",
      "**/*.json",
      "packages/*/src/**/*.css",
      // HTML 不纳入：Biome 会在元素内部插入换行缩进，改变 DOM 的 textContent，官网语言切换契约直接比对按钮文本
      // 由生成器产出，问题应在生成器里修；生成器带 --check 的会逐字节比对
      "!**/generated*.ts",
      "!**/package-lock.json",
      "!packages/edit-core/schemas",
      "!tooling/agent-eval/fixtures/manifest.json",
      "!tooling/font-glyph-samples/manifest.json",
      "!tooling/metafile-assets/manifest.json",
      "!tooling/template-fill-fonts/manifest.json",
      "!docs/*.archify.json",
      "!fixtures",
      "!tooling/agent-eval/records"
    ]
  },
  // 取值按重排前的实测风格调出，使整仓重排 diff 最小：
  // 2 空格、单引号、分号、尾逗号占绝对多数；手写代码没有固定行宽，140 贴近重排前 99 分位行长（145）
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 140
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "quoteProperties": "preserve",
      "operatorLinebreak": "before"
    }
  },
  // npm 与各生成器都按 JSON.stringify(_, null, 2) 写 JSON，数组一律展开才不会与它们来回改写
  "json": {
    "formatter": {
      "expand": "always"
    }
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      // 只启用能指向真实缺陷的规则。recommended 预设里的风格规则与本仓库的既定写法冲突：
      // 解析器大量使用「先校验再非空断言」、十六进制键的规范对照表、二进制格式里的控制字符正则、
      // while ((m = re.exec())) 循环，逐条改写只会制造无关 diff。
      "preset": "none",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": {
          "level": "error",
          "options": {
            "ignoreRestSiblings": true
          }
        },
        "noUnreachable": "error",
        "noConstAssign": "error",
        "noSelfAssign": "error",
        "noUnsafeFinally": "error",
        "noUnsafeOptionalChaining": "error",
        "noSwitchDeclarations": "error",
        "noInvalidConstructorSuper": "error",
        "noPrecisionLoss": "error",
        "noInvalidUseBeforeDeclaration": "error",
        "noUnusedLabels": "error",
        "noEmptyPattern": "error",
        "noSetterReturn": "error",
        "noGlobalObjectCalls": "error"
      },
      "suspicious": {
        "noDuplicateObjectKeys": "error",
        "noDuplicateCase": "error",
        "noDuplicateClassMembers": "error",
        "noDuplicateParameters": "error",
        "noDuplicateElseIf": "error",
        "noFallthroughSwitchClause": "error",
        "noSelfCompare": "error",
        "noAsyncPromiseExecutor": "error",
        "noCompareNegZero": "error",
        "noDebugger": "error",
        "noRedeclare": "error",
        "noSparseArray": "error",
        "noUnsafeNegation": "error",
        "noGlobalIsNan": "error",
        "noMisleadingCharacterClass": "error",
        "noFunctionAssign": "error",
        "noImportAssign": "error",
        "noClassAssign": "error",
        "noCatchAssign": "error",
        "noLabelVar": "error",
        "noDoubleEquals": "error",
        "noIrregularWhitespace": "error",
        "noThenProperty": "error"
      }
    }
  }
}
