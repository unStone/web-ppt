{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // 类型检查直接走源码，不依赖任何包已经构建过 —— 干净 clone 上 `npm run check` 也能过。
    // 只放在这里：各包的 tsconfig.build.json 设了 rootDir: src，
    // 若在 base 里全局映射，会把上游源码拖进下游的 .d.ts 产物。
    "paths": {
      "@web-ppt/core": ["./packages/core/src/index.ts"],
      "@web-ppt/core/worker": ["./packages/core/src/worker.ts"],
