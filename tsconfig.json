{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // 类型检查直接走源码，不依赖任何包已经构建过 —— 干净 clone 上 `npm run check` 也能过。
    // 只放在这里：各包的 tsconfig.build.json 设了 rootDir: src，
    // 若在 base 里全局映射，会把上游源码拖进下游的 .d.ts 产物。
    "paths": {
      "@web-ppt/core": ["./packages/core/src/index.ts"],
      "@web-ppt/core/worker": ["./packages/core/src/worker.ts"],
      "@web-ppt/core/geometry": ["./packages/core/src/geometry/index.ts"],
      "@web-ppt/core/geometry/handles": ["./packages/core/src/geometry/handles/index.ts"],
      "@web-ppt/core/image-zip": ["./packages/core/src/image-zip.ts"],
      "@web-ppt/core/chart-edit": ["./packages/core/src/chart-edit.ts"],
      "@web-ppt/edit-core": ["./packages/edit-core/src/index.ts"],
      "@web-ppt/edit-core/xml": ["./packages/edit-core/src/xml/index.ts"],
      "@web-ppt/edit-core/opc": ["./packages/edit-core/src/opc/index.ts"],
      "@web-ppt/edit-core/generate": ["./packages/edit-core/src/generate/index.ts"],
      "@web-ppt/edit-core/templates": ["./packages/edit-core/src/templates/index.ts"],
      "@web-ppt/edit-core/chart": ["./packages/edit-core/src/chart/index.ts"],
      "@web-ppt/edit-core/media": ["./packages/edit-core/src/media/index.ts"],
      "@web-ppt/collab": ["./packages/collab/src/index.ts"],
      "@web-ppt/editor": ["./packages/editor/src/index.ts"],
      "@web-ppt/editor/adjustments": ["./packages/editor/src/adjustments/index.ts"],
      "@web-ppt/editor/design": ["./packages/editor/src/design/index.ts"],
      "@web-ppt/editor/templates": ["./packages/editor/src/templates/index.ts"],
      "@web-ppt/editor/chart": ["./packages/editor/src/chart/index.ts"],
      "@web-ppt/editor/media": ["./packages/editor/src/media/index.ts"],
      "@web-ppt/react": ["./packages/react/src/index.ts"],
      "@web-ppt/react/templates": ["./packages/react/src/templates/index.ts"],
      "@web-ppt/react/chart": ["./packages/react/src/chart/index.ts"],
      "@web-ppt/react/media": ["./packages/react/src/media/index.ts"],
      "@web-ppt/vue": ["./packages/vue/src/index.ts"],
      "@web-ppt/vue/templates": ["./packages/vue/src/templates/index.ts"],
      "@web-ppt/vue/chart": ["./packages/vue/src/chart/index.ts"],
      "@web-ppt/vue/media": ["./packages/vue/src/media/index.ts"],
      "@web-ppt/viewer-core": ["./packages/viewer-core/src/index.ts"],
      "@web-ppt/fonts": ["./packages/fonts/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src",
    "tooling/type-contracts/animation.ts",
    "tooling/type-contracts/image-zip.ts",
    "tooling/type-contracts/v06-integration.ts",
    "tooling/type-contracts/v07-theme.ts",
    "tooling/type-contracts/v07-layout.ts",
    "tooling/type-contracts/v07-master.ts",
    "tooling/type-contracts/v07-templates.ts",
    "tooling/type-contracts/v08-chart.ts",
    "tooling/type-contracts/media.ts"
  ]
}
