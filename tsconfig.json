      "@web-ppt/react/chart-shared": ["./packages/react/src/chart-shared/index.ts"],
      "@web-ppt/react/media": ["./packages/react/src/media/index.ts"],
      "@web-ppt/vue": ["./packages/vue/src/index.ts"],
      "@web-ppt/vue/templates": ["./packages/vue/src/templates/index.ts"],
      "@web-ppt/vue/chart": ["./packages/vue/src/chart/index.ts"],
      "@web-ppt/vue/chart-shared": ["./packages/vue/src/chart-shared/index.ts"],
      "@web-ppt/vue/media": ["./packages/vue/src/media/index.ts"],
      "@web-ppt/viewer-core/comments": ["./packages/viewer-core/src/comments.ts"],
      "@web-ppt/viewer-core/video": ["./packages/viewer-core/src/video.ts"],
      "@web-ppt/viewer-core": ["./packages/viewer-core/src/index.ts"],
      "@web-ppt/fonts": ["./packages/fonts/src/index.ts"],
      "@web-ppt/fonts/glyphs": ["./packages/fonts/src/glyphs/index.ts"],
      "@web-ppt/fonts/glyphs/harfbuzz": ["./packages/fonts/src/glyphs/harfbuzz.ts"],
      "@web-ppt/fonts/glyphs/worker": ["./packages/fonts/src/glyphs/worker.ts"],
      "@web-ppt/fonts/glyphs/browser": ["./packages/fonts/src/glyphs/browser.ts"]
    }
  },
  "include": [
    "packages/*/src",
    "tooling/type-contracts/animation.ts",
    "tooling/type-contracts/image-zip.ts",
    "tooling/type-contracts/vector-pdf.ts",
    "tooling/type-contracts/v06-integration.ts",
    "tooling/type-contracts/v07-theme.ts",
    "tooling/type-contracts/v07-layout.ts",
